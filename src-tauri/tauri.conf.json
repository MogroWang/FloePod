{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FloePod",
  "mainBinaryName": "FloePod",
  "version": "0.6.0",
  "identifier": "com.mogrowang.floepod",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "url": "index.html",
        "title": "浮匣 设置",
        "width": 780,
        "height": 560,
        "minWidth": 700,
        "minHeight": 500,
        "visible": false,
        "resizable": true,
        "center": true,
        "skipTaskbar": false,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": ["settings", "pods"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
